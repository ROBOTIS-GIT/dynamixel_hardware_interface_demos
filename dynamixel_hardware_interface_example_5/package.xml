<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamixel_hardware_interface_example_5</name>
  <version>0.0.1</version>
  <description>
    Example package demonstrating a TurtleBot3 OpenCR-based ros2_control system
    (dynamixel_tb3_system) that drives the two wheel Dynamixels (ID 1, 2) and
    reads the OpenCR on-board IMU and battery voltage through a custom OpenCR
    firmware that speaks the Dynamixel protocol.
  </description>
  <maintainer email="pyo@robotis.com">Pyo</maintainer>
  <license>Apache 2.0</license>
  <author email="pyo@robotis.com">ROBOTIS</author>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>dynamixel_hardware_interface</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>dynamixel_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
