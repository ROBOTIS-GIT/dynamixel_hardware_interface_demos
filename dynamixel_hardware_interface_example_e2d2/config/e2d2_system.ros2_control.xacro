<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="e2d2_bridge_ros2_control" params="name joint_name port_name baud_rate dxl_id">
    <ros2_control name="${name}" type="system" is_async="true">
      <hardware>
        <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
        <param name="port_name">${port_name}</param>
        <param name="baud_rate">${baud_rate}</param>
        <param name="dynamixel_model_folder">/param/dxl_model</param>
        <param name="number_of_joints">1</param>
        <param name="number_of_transmissions">1</param>
        <param name="disable_torque_at_init">true</param>
        <param name="error_timeout_ms">1000</param>
        <param name="transmission_to_joint_matrix">
        1
        </param>
        <param name="joint_to_transmission_matrix">
        1
        </param>
        <param name="dynamixel_state_pub_msg_name">${name}/dxl_state</param>
        <param name="get_dynamixel_data_srv_name">${name}/get_dxl_data</param>
        <param name="set_dynamixel_data_srv_name">${name}/set_dxl_data</param>
        <param name="reboot_dxl_srv_name">${name}/reboot_dxl</param>
        <param name="set_dxl_torque_srv_name">${name}/set_dxl_torque</param>
      </hardware>

      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <gpio name="dxl${dxl_id}">
        <param name="type">dxl</param>
        <param name="ID">${dxl_id}</param>
        <command_interface name="Goal Position"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <param name="Return Delay Time">0</param>
      </gpio>
    </ros2_control>
  </xacro:macro>

  <xacro:macro name="e2d2_bridge_comm_test_ros2_control" params="name port_name baud_rate dxl_id">
    <ros2_control name="${name}" type="system" is_async="true">
      <hardware>
        <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
        <param name="port_name">${port_name}</param>
        <param name="baud_rate">${baud_rate}</param>
        <param name="dynamixel_model_folder">/param/dxl_model</param>
        <param name="number_of_joints">0</param>
        <param name="number_of_transmissions">0</param>
        <param name="disable_torque_at_init">true</param>
        <param name="error_timeout_ms">2000</param>
        <param name="dynamixel_state_pub_msg_name">${name}/dxl_state</param>
        <param name="get_dynamixel_data_srv_name">${name}/get_dxl_data</param>
        <param name="set_dynamixel_data_srv_name">${name}/set_dxl_data</param>
        <param name="reboot_dxl_srv_name">${name}/reboot_dxl</param>
        <param name="set_dxl_torque_srv_name">${name}/set_dxl_torque</param>
      </hardware>

      <gpio name="${name}_dxl${dxl_id}">
        <param name="type">sensor</param>
        <param name="ID">${dxl_id}</param>
      </gpio>
    </ros2_control>
  </xacro:macro>
</robot>
